---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

export interface Props {
  label: string;
  heading: string;
  poster: ImageMetadata;
  playLabel: string;
  pauseLabel: string;
  muteLabel: string;
  unmuteLabel: string;
}

const { label, heading, poster, playLabel, pauseLabel, muteLabel, unmuteLabel } = Astro.props;
const optimizedPoster = await getImage({ src: poster });
const demoSources = ['/demo-a.mp4', '/demo-b.mp4'];
---

<section class="pane demo" aria-label={heading}>
  <span class="pane__label mono">{label}</span>
  <div class="demo__frame">
    <div class="demo__scripted">
      <video
        data-demo-video
        muted
        loop
        playsinline
        preload="metadata"
        poster={optimizedPoster.src}
        data-demo-sources={demoSources.join(',')}
      ></video>
      <button
        type="button"
        class="demo__toggle demo__mute"
        data-demo-mute
        data-mute-label={muteLabel}
        data-unmute-label={unmuteLabel}
        aria-label={unmuteLabel}
      >
        <svg data-demo-icon-muted viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9 H8 L13 5 V19 L8 15 H4 Z" fill="currentColor" />
          <path
            d="M16 8 L21 16 M21 8 L16 16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <svg data-demo-icon-unmuted viewBox="0 0 24 24" aria-hidden="true" hidden>
          <path d="M4 9 H8 L13 5 V19 L8 15 H4 Z" fill="currentColor" />
          <path
            d="M16 8.5 C18 10 18 14 16 15.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          />
        </svg>
      </button>
      <button
        type="button"
        class="demo__toggle"
        data-demo-toggle
        data-play-label={playLabel}
        data-pause-label={pauseLabel}
        aria-label={playLabel}
      >
        <svg data-demo-icon-play viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5 L19 12 L8 19 Z" fill="currentColor" />
        </svg>
        <svg data-demo-icon-pause viewBox="0 0 24 24" aria-hidden="true" hidden>
          <rect x="6" y="5" width="4" height="14" fill="currentColor" />
          <rect x="14" y="5" width="4" height="14" fill="currentColor" />
        </svg>
      </button>
    </div>
    <noscript>
      <style is:inline>
        .demo__scripted {
          display: none;
        }
      </style>
      <video controls preload="metadata" poster={optimizedPoster.src}>
        <source src={demoSources[0]} type="video/mp4" />
      </video>
    </noscript>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-demo-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  const iconPlay = document.querySelector<SVGElement>('[data-demo-icon-play]');
  const iconPause = document.querySelector<SVGElement>('[data-demo-icon-pause]');
  const muteToggle = document.querySelector<HTMLButtonElement>('[data-demo-mute]');
  const iconMuted = document.querySelector<SVGElement>('[data-demo-icon-muted]');
  const iconUnmuted = document.querySelector<SVGElement>('[data-demo-icon-unmuted]');

  if (video && video.dataset.demoSources !== undefined) {
    const sources = video.dataset.demoSources.split(',');
    const chosen = sources[Math.floor(Math.random() * sources.length)];
    video.src = chosen;
  }

  if (
    video &&
    toggle &&
    iconPlay &&
    iconPause &&
    toggle.dataset.playLabel !== undefined &&
    toggle.dataset.pauseLabel !== undefined
  ) {
    const playLabel = toggle.dataset.playLabel;
    const pauseLabel = toggle.dataset.pauseLabel;

    const syncState = () => {
      const isPlaying = !video.paused && !video.ended;
      toggle.setAttribute('aria-label', isPlaying ? pauseLabel : playLabel);
      iconPlay.toggleAttribute('hidden', isPlaying);
      iconPause.toggleAttribute('hidden', !isPlaying);
    };

    video.addEventListener('play', syncState);
    video.addEventListener('pause', syncState);

    toggle.addEventListener('click', () => {
      if (video.paused) {
        void video.play();
      } else {
        video.pause();
      }
    });

    const wantsSaveData = (): boolean => {
      if (!('connection' in navigator)) return false;
      const connection: unknown = navigator.connection;
      if (typeof connection !== 'object' || connection === null) return false;
      if (!('saveData' in connection)) return false;
      return connection.saveData === true;
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion && !wantsSaveData()) {
      void video.play();
    }

    syncState();
  }

  if (
    video &&
    muteToggle &&
    iconMuted &&
    iconUnmuted &&
    muteToggle.dataset.muteLabel !== undefined &&
    muteToggle.dataset.unmuteLabel !== undefined
  ) {
    const muteLabel = muteToggle.dataset.muteLabel;
    const unmuteLabel = muteToggle.dataset.unmuteLabel;

    const syncMuteState = () => {
      const isMuted = video.muted;
      muteToggle.setAttribute('aria-label', isMuted ? unmuteLabel : muteLabel);
      iconMuted.toggleAttribute('hidden', !isMuted);
      iconUnmuted.toggleAttribute('hidden', isMuted);
    };

    video.addEventListener('volumechange', syncMuteState);

    muteToggle.addEventListener('click', () => {
      video.muted = !video.muted;
    });

    syncMuteState();
  }
</script>
