---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

export interface FeatureImage {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  tab: string;
  heading: string;
  body: string;
  image?: FeatureImage;
  span: 'full' | 'half';
  layout: 'text-image' | 'image-text' | 'stacked' | 'text-only';
}

const { tab, heading, body, image, span, layout } = Astro.props;
---

<div class:list={['pane', 'feature', `feature--${span}`, `feature--${layout}`]}>
  <span class="pane__label mono">{tab}</span>
  <div class="feature__text">
    <h2 class="feature__heading">{heading}</h2>
    <p class="feature__body">{body}</p>
  </div>
  {
    image && (
      <div class="feature__image">
        <Image src={image.src} alt={image.alt} />
      </div>
    )
  }
</div>
