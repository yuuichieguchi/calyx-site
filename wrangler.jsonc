{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calyx-site",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "getcalyx.app", "custom_domain": true },
    { "pattern": "www.getcalyx.app", "custom_domain": true }
  ]
}
